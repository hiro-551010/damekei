#!/usr/bin/env python3
"""
pre-commit hook: ステージされた実装ファイルに対応するdocsが存在するか確認する。
不足がある場合はコミットをブロックする。
"""
import os
import subprocess
import sys

LAYERS = {"application", "domain", "presentation"}
# infrastructure はdocs不要

def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True
    )
    return result.stdout.splitlines()

def check_docs(file_path):
    """対応するdocsパスを返す。問題なければ None。"""
    if not file_path.startswith("app/src/contexts/"):
        return None

    rel_path = file_path[len("app/src/contexts/"):]
    parts = rel_path.split("/")

    layer_idx = None
    for i, part in enumerate(parts):
        if part in LAYERS:
            layer_idx = i
            break

    if layer_idx is None:
        return None

    ctx_path = "/".join(parts[:layer_idx])
    layer = parts[layer_idx]

    stem = parts[-1].rsplit(".", 1)[0]
    expected_doc = f"{stem}.md"

    if layer == "presentation":
        docs_dir = f"docs/30_frontend/{ctx_path}"
        if not os.path.isdir(docs_dir) or not any(
            f.endswith(".md") for f in os.listdir(docs_dir)
        ):
            return docs_dir + "/*.md"
        return None
    else:
        sub_path = "/".join(parts[layer_idx + 1:-1])
        doc_dir = f"docs/10_contexts/{ctx_path}/{layer}/{sub_path}" if sub_path else f"docs/10_contexts/{ctx_path}/{layer}"
        docs_path = f"{doc_dir}/{expected_doc}"

        alt_docs_path = None
        if stem == "models":
            alt_docs_path = f"docs/10_contexts/{ctx_path}/{layer}/model.md"

        if not os.path.isfile(docs_path) and not (alt_docs_path and os.path.isfile(alt_docs_path)):
            return docs_path
        return None

def main():
    staged = get_staged_files()
    missing = []

    for f in staged:
        missing_doc = check_docs(f)
        if missing_doc:
            missing.append((f, missing_doc))

    if not missing:
        sys.exit(0)

    print("⛔ コミットをブロックしました: 以下の実装ファイルに対応するdocsがありません\n")
    for impl, doc in missing:
        print(f"  実装: {impl}")
        print(f"  docs: {doc}\n")
    print("実装をコミットする前にdocsを作成してください。")
    sys.exit(1)

if __name__ == "__main__":
    main()
